<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:icons="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             x:Class="DeepGate.Views.ChevronControl">
    <ContentView.Resources>
        <ResourceDictionary>
            <Style x:Key="ChevronLabelStyle" TargetType="Label">
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontSize" Value="10" />
            </Style>
            
            <Style x:Key="ChevronBorderStyle" TargetType="Border">
                <Setter Property="HeightRequest" Value="25" />
                <Setter Property="WidthRequest" Value="25" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="BackgroundColor" Value="#30FFFFFF" />
                <Setter Property="StrokeShape" Value="RoundRectangle 25" />
            </Style>
        </ResourceDictionary>
    </ContentView.Resources>
    
    <Grid
        ColumnDefinitions="Auto, *, Auto">

        <!--Left Chevron-->
        <Border
            x:Name="leftChevronBorder"
            Style="{StaticResource ChevronBorderStyle}">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnLeftArrowClicked"/>
            </Border.GestureRecognizers>
            <Label
                Style="{StaticResource ChevronLabelStyle}"
                icons:MauiIcon.Value="{icons:Cupertino Icon=ChevronLeft}"/>
        </Border>

        <Label
            Grid.Column="1"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            x:Name="selectionLabel"/>

        <!--Right Chevron-->
        <Border
            x:Name="rightChevronBorder"
            Grid.Column="2"
            Style="{StaticResource ChevronBorderStyle}">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnRightArrowClicked"/>
            </Border.GestureRecognizers>
            <Label
                Style="{StaticResource ChevronLabelStyle}"
                icons:MauiIcon.Value="{icons:Cupertino Icon=ChevronRight}"/>
        </Border>
     
    </Grid>
</ContentView>

